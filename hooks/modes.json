{
  "pcOnly": [
    "^mcp__Roblox_Studio__",
    "^mcp__blender__",
    "^mcp__computer-use__",
    "^mcp__claude-in-chrome__",
    "^mcp__Claude_Browser__",
    "^mcp__ghidra__",
    "^mcp__rea__",
    "^mcp__terminal__",
    "^mcp__agent-audio__",
    "^mcp__scheduled-tasks__",
    "^mcp__remote-devices__",
    "^mcp__plugin_",
    "^mcp__claude-code-remote__(list_computer_folders|request_computer_folder)$"
  ],
  "pcOnlySkills": "computer-use|chrome-browser|built-in-browser|roblox-vfx-pipeline",
  "pcOnlyBash": "\\b(blender|osascript|powershell|pwsh|winget|choco|brew|xdg-open|explorer\\.exe|cmd\\.exe|npx|wget|rojo|roblox ?studio)\\b|\\.exe\\b|\\bopen\\s+-a\\b|(^|[;&|]\\s*)start\\s|\\b[A-Za-z]:\\\\|\\bgit\\s+clone\\b|\\bapt(-get)?\\s+install\\b|\\bcurl\\b[^|;&]*\\s-[A-Za-z]*[oO]\\b(?!\\s+/dev/null)",
  "mobilePackages": [
    "three",
    "three-mesh-bvh",
    "three-bvh-csg",
    "mp4-muxer",
    "numpy",
    "pillow",
    "trimesh",
    "scipy",
    "rtree"
  ],
  "fallbacks": [
    {
      "match": "Roblox|rojo|roblox",
      "use": "edit .luau files in the Rojo layout in the repo and queue Studio steps in queue/pc.md"
    },
    {
      "match": "blender",
      "use": "prototype as a three.js artifact and save a bpy script for PC, queue the run"
    },
    {
      "match": "browser|chrome|Browser|computer-use",
      "use": "preview as an Artifact"
    },
    {
      "match": "agent-audio",
      "use": "procedural WebAudio SFX in code"
    },
    {
      "match": "install|npx|clone|curl|wget",
      "use": "use the vault's pinned packages (mobilePackages in hooks/modes.json) or CDN imports pinned to an exact version"
    },
    {
      "match": ".*",
      "use": "use Claude's own tools or an Artifact and queue the PC step"
    }
  ]
}
